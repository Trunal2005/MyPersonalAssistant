/* JUGNU's Qt theme. Each colour below is a palette key after a dollar sign; qt_app.py fills it in
   from the LIGHT or DARK palette in jugnu_core.py, so one file styles both themes. Widgets are matched by objectName (#name) or by the "variant",
   "role" and "state" properties set in qt_app.py. */

QMainWindow, QDialog, #content, #messages {
    background: $bg;
}
QWidget {
    color: $text;
}
QToolTip {
    background: $panel;
    color: $text;
    border: 1px solid $border;
}

/* ---------- Buttons ---------- */
QPushButton {
    background: $accent;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    font-weight: 600;
}
QPushButton:hover {
    background: $accent2;
}
QPushButton:pressed {
    background: $accent;
}
QPushButton:disabled {
    background: $border;
    color: $muted;
}
QPushButton:focus {
    outline: none;
}
QPushButton[variant="danger"] {
    background: $danger;
    color: $accent2;
}
QPushButton[variant="danger"]:hover {
    color: $text;
}
QPushButton[variant="stop"] {
    background: $accent2;
    padding: 4px 12px;
}
QPushButton[variant="stop"]:hover {
    background: $danger;
    color: $accent2;
}
/* Small text buttons inside a chat bubble (Copy, Read aloud). */
QPushButton[variant="ghost"] {
    background: transparent;
    color: $muted;
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 8pt;
}
QPushButton[variant="ghost"]:hover {
    background: $border;
    color: $accent;
}
QPushButton[variant="ghost"]:disabled {
    background: transparent;
    color: $border;
}
QPushButton[variant="ghost"][state="copied"] {
    color: #10B981;
}

/* ---------- Sidebar ---------- */
#sidebar {
    background: $sidebar;
}
#brand {
    color: $accent;
    font-size: 22pt;
    font-weight: 700;
}
#tagline, #historyLabel {
    color: $muted;
    font-size: 9pt;
}
#historyLabel {
    font-weight: 600;
}
#historyList {
    background: transparent;
    border: none;
    outline: none;
    font-size: 9pt;
}
#historyList::item {
    border-radius: 6px;
    padding: 6px 8px;
}
#historyList::item:hover {
    background: $border;
}
#historyList::item:selected {
    background: $accent;
    color: white;
}

/* ---------- Header ---------- */
#header {
    background: $accent;
}
#headerTitle {
    color: white;
    font-size: 15pt;
    font-weight: 700;
}
#status {
    color: #D1FAE5;
    font-size: 9pt;
    font-weight: 600;
}

/* ---------- Chat ---------- */
#chatScroll {
    background: $bg;
    border: none;
}
#bubble[role="user"] {
    background: $user;
    border-radius: 12px;
}
#bubble[role="assistant"] {
    background: $assistant;
    border-radius: 12px;
}
#bubbleName {
    color: $accent;
    font-size: 9pt;
    font-weight: 600;
}
#bubbleTime {
    color: $muted;
    font-size: 8pt;
}
#bubbleText {
    background: transparent;
    border: none;
    selection-background-color: $accent;
    selection-color: white;
}
#welcomeTitle {
    font-size: 23pt;
    font-weight: 700;
}
#welcomeTagline {
    color: $muted;
    font-size: 12pt;
}
#welcomePrompt, #welcomeEmoji {
    color: $accent;
    font-size: 12pt;
}
#welcomeEmoji {
    font-size: 64pt;
}

/* ---------- Input and dialogs ---------- */
QPlainTextEdit, QLineEdit {
    background: $entry;
    color: $text;
    border: 1px solid $border;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: $accent;
    selection-color: white;
}
QPlainTextEdit:focus, QLineEdit:focus {
    border: 1px solid $accent;
}
QLabel[variant="field"] {
    font-weight: 600;
}
QComboBox {
    background: $panel;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 6px 10px;
}
QComboBox:hover {
    border: 1px solid $accent;
}
QComboBox QAbstractItemView {
    background: $panel;
    color: $text;
    selection-background-color: $accent;
    selection-color: white;
    border: 1px solid $border;
}
QSlider::groove:horizontal {
    background: $border;
    height: 6px;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: $accent;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: $accent;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: $accent2;
}
QMenu {
    background: $panel;
    color: $text;
    border: 1px solid $border;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: $accent;
    color: white;
}
QMenu::item:disabled {
    color: $muted;
}

/* ---------- Scroll bars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: $border;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: $muted;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}
